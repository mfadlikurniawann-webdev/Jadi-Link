# Production template for backend/.env on the VPS. Copy, then fill in.
# Never commit the filled file. chmod 600 backend/.env
NODE_ENV=production
# Loopback only: nginx is the sole public entry point.
HOST=127.0.0.1
PORT=3001

# Neon production branch. Pooled URL for the app, direct URL for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
DIRECT_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_POOL_MAX=5

# Dashboard, API and short links all live on jadi.click (nginx + Let's Encrypt).
# Dashboard origin (exact, https, no path). Only this origin passes CORS.
FRONTEND_ORIGIN=https://jadi.click
# Public short-link origin (https, no path). deploy.sh also builds the
# dashboard with NEXT_PUBLIC_API_URL=<this>/api.
SHORT_LINK_BASE_URL=https://jadi.click
# nginx on the same host. Never "*" and never a public range.
TRUST_PROXY=127.0.0.1,::1

# Two different random values (see README):
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=900
VISITOR_HASH_SECRET=replace-with-another-random-secret-at-least-32-characters
