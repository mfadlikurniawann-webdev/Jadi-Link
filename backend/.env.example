# Copy to .env. Never commit real credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# Neon pooled URL (hostname contains -pooler) for application queries.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
# Neon direct URL for migrations. Falls back to DATABASE_URL when omitted.
DIRECT_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_POOL_MAX=5

FRONTEND_ORIGIN=http://localhost:3000
SHORT_LINK_BASE_URL=http://localhost:3001
# Only trust the local reverse proxy. Never use "*" on an exposed server.
TRUST_PROXY=127.0.0.1,::1

# Generate independently: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=900
VISITOR_HASH_SECRET=replace-with-another-random-secret-at-least-32-characters
